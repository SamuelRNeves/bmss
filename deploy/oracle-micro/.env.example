# Copie para .env e preencha. O .env NUNCA deve ir para o GitHub.

# Domínio público da API. Sem domínio próprio, use o sslip.io com o IP da VM:
#   IP 129.146.10.20  ->  DOMAIN=129-146-10-20.sslip.io
DOMAIN=

# Senha do PostgreSQL (gere uma: openssl rand -base64 24)
POSTGRES_PASSWORD=

# Segredo do JWT, no mínimo 32 caracteres (gere um: openssl rand -base64 64)
JWT_SECRET=

# Chave da NewsAPI (https://newsapi.org) — gere uma NOVA, a antiga ficou pública
NEWSAPI_API_KEY=

# E-mail via Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=BMSS Alerts <onboarding@resend.dev>

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
