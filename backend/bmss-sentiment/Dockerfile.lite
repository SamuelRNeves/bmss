# ================================
# 🪶 BMSS Sentiment — versão leve
# Só análise por palavras-chave, sem PyTorch (~50 MB de RAM)
# ================================
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    BMSS_DISABLE_MODEL=1

WORKDIR /app

COPY requirements-lite.txt .
RUN pip install -r requirements-lite.txt

COPY app.py .

EXPOSE 5000

# 1 processo com 4 threads: pouca memória, suficiente para o tráfego do BMSS
CMD ["gunicorn", "-w", "1", "--threads", "4", "--timeout", "120", "-b", "0.0.0.0:5000", "app:app"]
