# ================================
# 🔥 BMSS Sentiment Microservice
# Flask + Transformers + Torch (CPU)
# ================================
FROM python:3.10-slim

# Evita buffering e garante logs imediatos
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget curl && \
    rm -rf /var/lib/apt/lists/*

# Copiar dependências
COPY requirements.txt .

# Instalar libs sem GPU (CPU only) — funciona em x86_64 e em Arm (Oracle Ampere)
RUN pip install --upgrade pip && \
    if [ "$(uname -m)" = "x86_64" ]; then \
      pip install torch==2.5.1 --index-url https://download.pytorch.org/whl/cpu; \
    else \
      pip install torch==2.5.1; \
    fi && \
    pip install -r requirements.txt

# 🔥 Baixar o modelo ANTES do runtime (evita delay)
RUN python - <<EOF
from transformers import pipeline
print("📦 Baixando modelo FinBERT...")
pipeline(
    "sentiment-analysis",
    model="mrm8488/distilroberta-finetuned-financial-news-sentiment-analysis"
)
print("✅ Modelo baixado com sucesso!")
EOF

# Copia o app depois do build (boa prática)
COPY . .

EXPOSE 5000

# Gunicorn como servidor de produção (timeout maior para lotes de notícias)
CMD ["gunicorn", "-w", "2", "--timeout", "120", "-b", "0.0.0.0:5000", "app:app"]
